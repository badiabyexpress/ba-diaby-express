# Copiez ce fichier en ".env" pour le développement local (npm run dev).
# Sur Vercel, ne créez PAS de fichier .env : ajoutez ces variables dans
# Project Settings > Environment Variables (voir DEPLOIEMENT.md).

# Clé API Anthropic — utilisée UNIQUEMENT côté serveur (api/claude.js).
# Ne jamais préfixer par VITE_ : une variable VITE_* est envoyée au navigateur
# et serait visible par n'importe qui. Récupérez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Connexion Supabase — le projet "Site transport colis" a déjà été créé pour vous.
# Ces valeurs PEUVENT être publiques (préfixe VITE_ obligatoire, elles sont envoyées
# au navigateur) : la clé "anon" est conçue pour ça, la vraie protection vient de
# l'écran de connexion de l'application (voir la note de sécurité dans src/lib/storage.js).
VITE_SUPABASE_URL=https://vtzpejzghtcakqucuvmc.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ0enBlanpnaHRjYWtxdWN1dm1jIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ2MzM2NzEsImV4cCI6MjEwMDIwOTY3MX0.-fTq_veRgH-U-ZhmxhBTHKfCKIg5LdcfTm-eRGkJlPo

# --- WhatsApp via Twilio (facultatif) ---------------------------------------
# Tant que ces trois variables sont absentes, l'application ouvre un brouillon
# WhatsApp que l'agent envoie lui-même : rien ne casse.
#
# TWILIO_AUTH_TOKEN est un MOT DE PASSE : à saisir uniquement dans
# Vercel > Project Settings > Environment Variables. Ne le mettez jamais dans un
# fichier versionné, ni dans une capture d'écran, ni dans un message.
#
# TWILIO_WHATSAPP_FROM :
#   - bac à sable  : whatsapp:+14155238886  (numéro partagé Twilio, essais uniquement)
#   - professionnel: whatsapp:+224XXXXXXXXX (votre numéro validé par Meta)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=votre_auth_token_secret
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- E-mail via Resend (facultatif) ----------------------------------------
# Tant que ces variables sont absentes, le bouton « Envoyer par e-mail » ouvre
# un brouillon dans le logiciel de messagerie : rien ne casse.
#
# RESEND_API_KEY est un SECRET : à saisir uniquement dans
# Vercel > Project Settings > Environment Variables.
#
# EMAIL_FROM doit utiliser un domaine vérifié chez Resend. Sans domaine à vous,
# utilisez l'adresse de test fournie par Resend : les e-mails ne partiront qu'à
# votre propre adresse, ce qui suffit pour valider le circuit.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Ba-Diaby Express <contact@votredomaine.com>
